---
import Layout from "@/layouts/Layout.astro";
import { TenantsTable } from "@/components/admin/tenants-table";

const API_TOKEN = import.meta.env.API_TOKEN;

const response = await fetch(`${Astro.url.origin}/api/tenants`, {
	headers: {
		Authorization: `Bearer ${API_TOKEN}`,
	},
});

const { tenants } = await response.json();
---

<Layout title="Tenants">
	<div class="space-y-6">
		<div class="flex items-center justify-between">
			<div>
				<h1 class="text-3xl font-bold">Tenant Management</h1>
				<p class="text-muted-foreground mt-1">
					Manage all FlareCog platform tenants
				</p>
			</div>
			<button
				class="px-4 py-2 bg-primary text-primary-foreground rounded-md hover:bg-primary/90 transition-colors"
			>
				Create Tenant
			</button>
		</div>

		<div class="grid grid-cols-1 md:grid-cols-4 gap-4">
			<div class="bg-card border rounded-lg p-4">
				<div class="text-sm font-medium text-muted-foreground">
					Total Tenants
				</div>
				<div class="text-2xl font-bold mt-1">{tenants.length}</div>
			</div>
			<div class="bg-card border rounded-lg p-4">
				<div class="text-sm font-medium text-muted-foreground">
					Active
				</div>
				<div class="text-2xl font-bold mt-1 text-green-600">
					{
						tenants.filter((t) => t.status === "active")
							.length
					}
				</div>
			</div>
			<div class="bg-card border rounded-lg p-4">
				<div class="text-sm font-medium text-muted-foreground">
					Pro Tier
				</div>
				<div class="text-2xl font-bold mt-1 text-blue-600">
					{tenants.filter((t) => t.tier === "pro").length}
				</div>
			</div>
			<div class="bg-card border rounded-lg p-4">
				<div class="text-sm font-medium text-muted-foreground">
					Enterprise
				</div>
				<div class="text-2xl font-bold mt-1 text-purple-600">
					{
						tenants.filter((t) => t.tier === "enterprise")
							.length
					}
				</div>
			</div>
		</div>

		<TenantsTable data={tenants} client:load />
	</div>
</Layout>
